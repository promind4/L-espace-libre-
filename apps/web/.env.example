# L'Espace Libre — variables d'environnement
# Copier en .env.local pour le développement, configurer dans Vercel pour la production.

# Resend (e-mail transactionnel)
RESEND_API_KEY=re_xxx_replace_me
LEADS_INBOX_EMAIL=leads@lespace-libre.fr

# Google Analytics 4 (public)
# Format : G-XXXXXXXXXX (récupéré depuis Admin → Flux de données GA4)
# Laisser vide ou commenter pour désactiver complètement le tag GA en dev.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Plausible analytics — alternative à GA, non câblée par défaut.
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=lespace-libre.fr

# Site (public)
NEXT_PUBLIC_SITE_URL=https://lespace-libre.fr

# Pricing overrides (optionnels — surchargent PRICING_CONSTANTS si définis)
# PRICING_BASE_FORFAIT=80
# PRICING_RATE_PER_M3=45
# PRICING_GIRONDE_HORS_CUB_FLAT=65
